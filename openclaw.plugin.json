{
  "id": "video-assets",
  "name": "视频资产库",
  "description": "面向视频生产的项目资产库、制作画布与生成写回插件。",
  "version": "0.2.0",
  "contracts": {
    "tools": [
      "video_asset_ingest",
      "video_asset_search",
      "video_asset_get",
      "video_asset_update_metadata",
      "video_asset_update_rights",
      "video_asset_create_version",
      "video_asset_create_branch",
      "video_asset_save_copy",
      "video_asset_lineage",
      "video_asset_register_derived_file",
      "video_asset_generate_derived_file",
      "video_asset_derived_files",
      "video_asset_integrity_scan",
      "video_asset_classify",
      "video_asset_get_classification",
      "video_asset_taxonomy_report",
      "video_entity_create",
      "video_entity_search",
      "video_entity_link_asset",
      "video_asset_annotate",
      "video_asset_annotations",
      "video_asset_update_annotation",
      "video_canvas_agent_context",
      "video_canvas_apply_production_template",
      "video_canvas_create_revision_card",
      "video_canvas_create_generation_slot",
      "video_canvas_create",
      "video_canvas_delete_shape",
      "video_audio_doubao_generate",
      "video_audio_doubao_plan",
      "video_audio_kie_suno_generate",
      "video_audio_kie_suno_plan",
      "video_canvas_doubao_audio_generate",
      "video_canvas_doubao_audio_plan",
      "video_canvas_kie_suno_audio_generate",
      "video_canvas_kie_suno_audio_plan",
      "video_canvas_dreamina_cli_generate_video",
      "video_canvas_dreamina_cli_generate_image",
      "video_canvas_dreamina_cli_upscale_image",
      "video_canvas_dreamina_cli_plan",
      "video_canvas_export_annotation_brief",
      "video_canvas_fill_generation_slot",
      "video_canvas_generation_handoff",
      "video_canvas_generation_package",
      "video_canvas_get_selection",
      "video_canvas_get_view_state",
      "video_canvas_get",
      "video_canvas_insert_generated_asset",
      "video_canvas_link_shapes",
      "video_canvas_lint",
      "video_canvas_register_review_annotation",
      "render_video_assets_canvas_widget",
      "video_canvas_save_selection",
      "video_canvas_save_snapshot",
      "video_canvas_save_view_state",
      "video_canvas_search",
      "video_canvas_unlink_shapes",
      "video_canvas_update_generation_slot",
      "video_canvas_update_revision_card_status",
      "video_canvas_upsert_shape",
      "video_canvas_widget_context",
      "video_project_create",
      "video_project_update_spec",
      "video_project_add_asset_ref",
      "video_project_update_asset_ref",
      "video_project_remove_asset_ref",
      "video_project_refs",
      "video_project_asset_report",
      "video_project_continuity_report",
      "video_novel_document",
      "video_novel_workflow",
      "video_novel_adaptation",
      "video_novel_generate"
    ]
  },
  "activation": {
    "onStartup": true
  },
  "configContracts": {
    "secretInputs": {
      "paths": [
        {
          "path": "audio.kie.apiKey",
          "expected": "string",
          "ownerKind": "capability"
        },
        {
          "path": "audio.doubao.apiKey",
          "expected": "string",
          "ownerKind": "capability"
        },
        {
          "path": "narrative.model.apiKey",
          "expected": "string",
          "ownerKind": "capability"
        }
      ]
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "repositoryRoot": {
        "type": "string",
        "description": "素材与项目仓库根目录，默认使用 ~/.openclaw-video-assets。支持云端对象存储：用 rclone 磁盘模式挂载后将 asset-repo/objects 替换为 Junction/symlink 即可（勿用 --network-mode），metadata 与 cache 须留本地；详见 README「云端对象存储接入」。"
      },
      "allowPhysicalDelete": {
        "type": "boolean",
        "description": "预留配置。当前版本保持关闭，仅支持归档或软删除语义。"
      },
      "toolSurface": {
        "type": "string",
        "enum": [
          "legacy",
          "contract"
        ],
        "description": "工具面强制选择；缺省按 manifest contracts.tools 推导。"
      },
      "basePath": {
        "type": "string",
        "description": "顶层 basePath 回退；security.basePath 优先。"
      },
      "audio": {
        "type": "object",
        "additionalProperties": false,
        "description": "音频生成适配器凭据配置。密钥字段支持 SecretRef（如 {\"source\":\"store\",\"provider\":\"default\",\"id\":\"KIE_API_KEY\"}），网关启动时物化为字符串注入插件；留空回退到对应环境变量。",
        "properties": {
          "kie": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "apiKey": {
                "description": "KIE Suno API Key（Bearer）。优先于 process.env.KIE_API_KEY。",
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "properties": {
                      "source": {
                        "type": "string",
                        "enum": [
                          "env",
                          "file",
                          "exec",
                          "store"
                        ]
                      },
                      "id": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "provider": {
                        "minLength": 1,
                        "type": "string"
                      }
                    },
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "source",
                      "provider",
                      "id"
                    ]
                  }
                ]
              }
            }
          },
          "doubao": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "apiKey": {
                "description": "豆包音频 API Key（X-Api-Key）。优先于 process.env.VOLCENGINE_DOUBAO_AUDIO_API_KEY。",
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "properties": {
                      "source": {
                        "type": "string",
                        "enum": [
                          "env",
                          "file",
                          "exec",
                          "store"
                        ]
                      },
                      "id": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "provider": {
                        "minLength": 1,
                        "type": "string"
                      }
                    },
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "source",
                      "provider",
                      "id"
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "upload": {
        "type": "object",
        "additionalProperties": false,
        "description": "REN-06 大素材流式上传限额。服务端在这些上限内接受上传；客户端会读到同样的数值，但即使客户端忽略它们，服务端仍会拒绝。所有数值都会被钳制到合理范围内，而不是照单全收。",
        "properties": {
          "enabled": {
            "type": "boolean",
            "description": "是否启用流式上传端点，默认开启。"
          },
          "maxFileBytes": {
            "type": "number",
            "minimum": 1048576,
            "description": "单文件上限（字节），默认 512 MiB。必须大于你认为合法的最大素材，否则合法用例会先被拒绝。"
          },
          "maxConcurrentTransfers": {
            "type": "number",
            "minimum": 1,
            "maximum": 64,
            "description": "同时进行写入的传输数上限，默认 2。其余请求在有界等待区排队，等待区满则明确拒绝。"
          },
          "maxQueuedTransfers": {
            "type": "number",
            "minimum": 0,
            "maximum": 4096,
            "description": "等待区长度，默认 8；设为 0 表示不排队（有空位才运行，否则拒绝）。"
          },
          "stagingTotalBytes": {
            "type": "number",
            "minimum": 1048576,
            "description": "暂存区总量上限（字节，含临时文件与隔离文件），默认 4 GiB。"
          },
          "minFreeBytes": {
            "type": "number",
            "minimum": 0,
            "description": "最低磁盘余量（字节），默认 512 MiB。写入会低于该余量时拒绝并返回 507。"
          },
          "maxChunkBytes": {
            "type": "number",
            "minimum": 65536,
            "description": "单个分片上限（字节），默认 16 MiB。客户端的分片大小不得超过它。"
          },
          "sessionTtlMinutes": {
            "type": "number",
            "minimum": 1,
            "description": "上传会话保留时长（分钟），默认 720。过期只标记状态，不删除任何字节。"
          },
          "quarantineUnknownTypes": {
            "type": "boolean",
            "description": "无法识别或与扩展名矛盾的内容是否隔离保留（默认 true）。关闭后此类上传被拒绝且不保留字节。"
          },
          "allowedExtensions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "允许的扩展名白名单（含点号，小写）。留空使用内置默认列表。"
          }
        }
      },
      "auth": {
        "type": "object",
        "additionalProperties": false,
        "description": "面向公网访问时的插件级二次认证；如网关认证可用，仍需保留网关认证。",
        "properties": {
          "enabled": {
            "type": "boolean",
            "description": "启用插件密码与会话认证，默认开启。"
          },
          "adminPasswordHash": {
            "type": "string",
            "description": "由安全管理器生成的密码哈希。不要保存明文密码；本字段仅为兼容保留，本地私有部署优先使用哈希文件。"
          },
          "adminPasswordHashFile": {
            "type": "string",
            "description": "保存管理员密码哈希的本地私有文件路径，推荐优先使用。"
          },
          "sessionTtlMinutes": {
            "type": "number",
            "minimum": 5,
            "description": "插件会话有效时长，单位分钟，默认 480。"
          },
          "maxLoginAttempts": {
            "type": "number",
            "minimum": 1,
            "description": "同一登录窗口内每个地址允许的最大失败次数，默认 5。"
          },
          "loginWindowMinutes": {
            "type": "number",
            "minimum": 1,
            "description": "登录限流窗口，单位分钟，默认 10。"
          },
          "allowedOrigins": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "公网部署时可选的浏览器来源白名单；留空表示依赖网关或代理的来源策略。"
          }
        }
      },
      "security": {
        "type": "object",
        "additionalProperties": false,
        "description": "REN-02 安全边界：basePath、Origin/CSRF、可信代理、Cookie 与生成授权/成本门控。默认 fail-closed：生成授权在显式配置前一律拒绝；代理头默认不信任；声明部署源后，携带会话 Cookie 的写请求强制校验 Origin。",
        "properties": {
          "basePath": {
            "type": "string",
            "description": "插件统一挂载前缀（路由、会话 Cookie Path、工作台 URL 均由此派生）。默认 /__openclaw__/video-assets；改动后需重新构建 ui-src（ui-dist 目前按默认前缀编译）。"
          },
          "publicOrigin": {
            "type": "string",
            "description": "部署对外源（例如 https://chat.tkx.info）。声明后，携带会话 Cookie 的写请求必须携带白名单内 Origin。"
          },
          "allowedOrigins": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "额外允许的浏览器来源，与 auth.allowedOrigins 合并。"
          },
          "csrfMode": {
            "type": "string",
            "enum": [
              "auto",
              "strict",
              "off"
            ],
            "description": "auto（默认）：声明部署源后严格校验；strict：即使未声明部署源，携带会话 Cookie 的写请求也必须带合法 Origin；off 仅供隔离回归使用。"
          },
          "deriveOriginFromHost": {
            "type": "boolean",
            "description": "是否允许按请求 Host 推导同源 Origin（默认 true）。仅在未配置 publicOrigin/allowedOrigins 且 Host 为 loopback/localhost 时生效：显式配置的源永远是权威白名单，请求 Host 不会扩充它，公网域名也不会被隐式信任。"
          },
          "enforceCookieCsrf": {
            "type": "boolean",
            "description": "是否对携带会话 Cookie 的写请求强制 Origin（默认 true）。Bearer 令牌客户端不受此限制。"
          },
          "trustProxyHeaders": {
            "type": "boolean",
            "description": "是否信任 X-Forwarded-For / X-Forwarded-Proto（默认 false）。开启后仍需配置 trustedProxies，否则转发头仍被忽略。"
          },
          "trustedProxies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "可信代理地址或 IPv4 CIDR（例如 127.0.0.1、10.0.0.0/8）。只有来自这些地址的请求才能影响客户端 IP 与协议判定。"
          },
          "cookieSecure": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string",
                "enum": [
                  "auto"
                ]
              }
            ],
            "description": "会话 Cookie 的 Secure 属性：auto（默认，按有效协议判定，HTTPS 或可信代理声明 https 时追加）、true（强制）、false（关闭，仅限本地 HTTP 调试）。"
          },
          "sessionIdleMinutes": {
            "type": "number",
            "minimum": 1,
            "description": "会话空闲超时（分钟）。配置后空闲超时即失效；不配置则只受绝对 TTL 限制。"
          },
          "generation": {
            "type": "object",
            "additionalProperties": false,
            "description": "生成授权与成本门控（REN-02）。默认 mode=enforce、allowSurfaces=[]、ledger=none，因此任何真实 provider 调用都会被拒绝，直到显式配置。",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "enforce",
                  "monitor"
                ],
                "description": "enforce（默认）真正拦截；monitor 只记录决策、仍拒绝任何真实 provider 提交（无法用配置把监控变成放行）。"
              },
              "allowSurfaces": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "tool",
                    "gateway",
                    "browser"
                  ]
                },
                "description": "允许发起真实生成的调用面。默认空。"
              },
              "allowActors": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "允许生成的可信身份模式（支持 * 通配，例如 human:plugin-admin、agent:*）。仅在宿主提供可信身份时生效。"
              },
              "unattributedPolicy": {
                "type": "string",
                "enum": [
                  "deny",
                  "allow-with-surface-grant"
                ],
                "description": "宿主未提供可信身份时的策略：deny（默认）或 allow-with-surface-grant（需同时把该调用面列入 unattributedSurfaces）。工具面身份来自宿主工具工厂上下文（agentId/senderIsOwner 等），因此只有宿主确实不提供身份时才需要放宽。"
              },
              "unattributedSurfaces": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "tool",
                    "gateway",
                    "browser"
                  ]
                },
                "description": "允许在无身份归因下发起生成的调用面（默认 [\"tool\"]）。"
              },
              "requireOperatorScope": {
                "type": "boolean",
                "description": "是否要求可信上下文携带 operator.admin/operator.write 范围。默认 true；宿主无法提供 scope 时才关闭，此时仅由 allowActors 决定身份。"
              },
              "authorizationTtlSeconds": {
                "type": "number",
                "minimum": 1,
                "description": "单次生成授权（audit_id）的有效期，秒。默认 900；过期后重放旧授权会被拒绝。"
              },
              "requireConfirmation": {
                "type": "boolean",
                "description": "是否要求显式成本确认（accept_credit_spend / accept_cost / confirm_cost）。默认 true。"
              },
              "requireBudget": {
                "type": "boolean",
                "description": "是否要求可解析的预算台账。默认 true；无台账时拒绝真实生成。"
              },
              "ledger": {
                "type": "string",
                "enum": [
                  "none",
                  "memory",
                  "persistent"
                ],
                "description": "预算台账实现：none（默认，拒绝真实生成）、memory（进程内零成本台账，用于隔离验证）、persistent（用队列的持久 generation_budget_ledger 表记账；同一 job 的一条预留行同时约束两层，重启不会重复预留）。持久台账的权威仍是队列表（REN-10）。"
              },
              "budget": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "totalCredits": {
                    "type": "number",
                    "minimum": 0,
                    "description": "预算额度（credits）。"
                  },
                  "period": {
                    "type": "string",
                    "enum": [
                      "day",
                      "session",
                      "lifetime"
                    ],
                    "description": "预算周期语义（REN-10 落地持久台账时生效）。"
                  },
                  "estimates": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "number",
                      "minimum": 0
                    },
                    "description": "按生成入口覆盖的单次成本估算（credits），键为入口 id（例如 dreamina.video.generate）。这是唯一的成本证据来源：未配置的入口一律以 GENERATION_BUDGET_UNKNOWN_COST 拒绝，入口内置的参考价不会被当作预算依据。"
                  },
                  "perEntry": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "number",
                      "minimum": 0
                    },
                    "description": "按入口的额外上限（credits）。totalCredits 是所有入口共享的总池，perEntry 是在共享池之外对该入口的额外约束，两者需同时满足。"
                  }
                }
              }
            }
          }
        }
      },
      "canvas": {
        "type": "object",
        "additionalProperties": false,
        "description": "REN-08 可编辑画布。editing 关掉时服务端拒绝一切画布编辑命令、界面退为只读（回滚开关，不只是界面提示）；viewportDebounceMs 是视口写入的防抖毫秒数，客户端会读到同一个值，服务端不依赖它。",
        "properties": {
          "editing": {
            "type": "boolean",
            "description": "是否允许画布编辑命令，默认开启。关闭后 canvas.applyCommand 一律拒绝（403），命令日志与快照保留，可回放。"
          },
          "viewportDebounceMs": {
            "type": "number",
            "minimum": 200,
            "maximum": 2000,
            "description": "视口写入防抖毫秒数（默认 400）。会被钳制到 200..2000：0 会让每次平移都写一帧，过长会丢失视图状态。"
          }
        }
      },
      "generationJobs": {
        "type": "object",
        "additionalProperties": false,
        "description": "REN-10 持久异步生成队列。默认关闭且预算为 0；只有显式授权后才允许排队，关闭不影响已提交任务的对账与收取。",
        "properties": {
          "enabled": {
            "type": "boolean",
            "description": "允许创建新的异步生成 job；默认 false。"
          },
          "maxCredits": {
            "type": "number",
            "minimum": 0,
            "description": "持久预算上限；预留与已提交费用共同计入。"
          },
          "maxConcurrent": {
            "type": "number",
            "minimum": 1,
            "maximum": 8,
            "description": "本地 worker 并发上限。"
          },
          "allowedActors": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "允许创建 job 的可信 actor；空数组表示只依赖可信 scope。"
          },
          "allowedSurfaces": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "tool",
                "ui",
                "browser",
                "gateway"
              ]
            },
            "description": "工具与 UI 共用的服务端入口表面白名单。"
          }
        }
      },
      "narrative": {
        "type": "object",
        "additionalProperties": false,
        "description": "小说叙事域：编辑/审定/导出始终可用，独立模型默认不付费",
        "properties": {
          "model": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean",
                "default": false
              },
              "endpoint": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "apiKey": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "source",
                      "provider",
                      "id"
                    ],
                    "properties": {
                      "source": {
                        "type": "string",
                        "enum": [
                          "env",
                          "file",
                          "exec"
                        ]
                      },
                      "provider": {
